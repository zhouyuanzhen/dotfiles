# --- Theme Settings ---
theme = Catppuccin Mocha

shell-integration = zsh
shell-integration-features = ssh-terminfo,ssh-env
#shell-integration-features = xterm-256color

# --- Fonts Settings ---
# Recommend using: "Nerd Fonts" for icon friendly
# font-family = "JetBrains Mono"
font-family = "Menlo"
font-size = 12
# 连字特性（!= 变成 ≠）
font-feature = calt
font-feature = liga

# --- Keybind Settings ---
# https://ghostty.org/docs/keybindings
keybind = cmd+shift+r=reload_config
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+shift+enter=toggle_fullscreen
#keybind = cmd+f=search
keybind = global:ctrl+shift+cmd+o=toggle_quick_terminal

# --- Window and Apperances Settings ---
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.5

# --- Cursor Settings ---
cursor-style = bar
cursor-style-blink = false
cursor-color = #FF0000
cursor-opacity = 0.8

# --- Mouse Settings ---
mouse-hide-while-typing = true


selection-foreground = #00FF00
selection-background = #555555
background-opacity = 0.9
background-blur = true

unfocused-split-opacity = 0.9
unfocused-split-fill = #aaaaaa

# working-directory = inherit
copy-on-select = true

# 
window-save-state = always

# 
shell-integration = detect

# --- update Settings ---
auto-update = off
auto-update-channel = stable
